{
  "name": "sparr",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production node --env-file-if-exists=.env --import tsx src/server/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:strict:lab": "node --import tsx scripts/strict-lab.ts",
    "test:seb:lab": "node --env-file-if-exists=.env --import tsx scripts/seb-lab.ts",
    "check": "tsc --noEmit",
    "native:build": "bash scripts/build-native.sh",
    "format": "prettier --write src tests scripts/*.ts *.ts",
    "verify:local-model": "node --import tsx scripts/verify-local-model.ts"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.4",
    "csv-parse": "^7.0.3",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.9.1",
    "multer": "^2.0.2",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.9.0",
    "tsx": "^4.20.0",
    "vite": "^7.1.9",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/supertest": "^6.0.0",
    "prettier": "^3.9.9",
    "supertest": "^7.1.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  },
  "description": "Local interview practice with resume and project context, executable checks, and open-model feedback.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Hasan72341/sparr.git"
  },
  "homepage": "https://github.com/Hasan72341/sparr#readme",
  "bugs": {
    "url": "https://github.com/Hasan72341/sparr/issues"
  }
}
